@page "/Account/AccessDenied"
@layout RjamBakery.Web.Components.Layout.AuthLayout

<h2 style="margin:0 0 8px 0; font-size:1.25rem; color:#B84A39;">Access Denied</h2>
<p style="margin:0 0 20px 0; font-size:0.9rem; color:#6F5B53;">
    Your current role does not have permission to view this page or execute this action.
</p>
<a href="/" class="auth-btn" style="display:block; text-align:center; text-decoration:none; box-sizing:border-box;">
    Return to Dashboard
</a>
