@page "/Account/ChangePassword"
@layout RjamBakery.Web.Components.Layout.AuthLayout
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using RjamBakery.Application.Services
@using RjamBakery.Domain.Entities
@using RjamBakery.Infrastructure.Persistence
@using RjamBakery.Web.Security

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AppDbContext Db
@inject IAuditLogService Audit
@inject NavigationManager Navigation

<PageTitle>Change Password - RJAM Bakery</PageTitle>

<h2 style="margin:0 0 6px 0; font-size:1.25rem; color:#2E1C16;">Change Password</h2>
<p style="margin:0 0 18px 0; font-size:0.85rem; color:#6F5B53;">
    @(Forced
        ? "For security, please replace your temporary password before continuing."
        : "Update your RJAM Bakery account password. Minimum 8 characters with uppercase, lowercase, and a number.")
</p>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="auth-alert-error" role="alert">@_errorMessage</div>
}

<EditForm Model="Input" method="post" FormName="ChangePasswordForm" OnValidSubmit="HandleChangePasswordAsync" class="auth-submit-form" data-loading-text="Updating your password...">
    <DataAnnotationsValidator />
    <ValidationSummary style="color:#B84A39; font-size:0.82rem; margin-bottom:12px;" />

    <div class="auth-field">
        <label class="auth-label" for="current-password">Current Password</label>
        <InputText id="current-password" type="password" class="auth-input" @bind-Value="Input.CurrentPassword" autocomplete="current-password" maxlength="128" />
    </div>

    <div class="auth-field">
        <label class="auth-label" for="new-password">New Password</label>
        <InputText id="new-password" type="password" class="auth-input" @bind-Value="Input.NewPassword" autocomplete="new-password" maxlength="128" />
    </div>

    <div class="auth-field">
        <label class="auth-label" for="confirm-password">Confirm New Password</label>
        <InputText id="confirm-password" type="password" class="auth-input" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" maxlength="128" />
    </div>

    <button type="submit" class="auth-btn">Update Password</button>

    @if (!Forced)
    {
        <div style="text-align:center; margin-top:14px;">
            <a href="/" style="font-size:0.85rem; color:#6F5B53; text-decoration:none;">Cancel and return to Dashboard</a>
        </div>
    }
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery]
    public bool Forced { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private ChangePasswordInputModel Input { get; set; } = new();

    private string? _errorMessage;

    private async Task HandleChangePasswordAsync()
    {
        var userId = HttpContext?.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        if (string.Equals(Input.CurrentPassword, Input.NewPassword, StringComparison.Ordinal))
        {
            _errorMessage = "Your new password must be different from your current password.";
            return;
        }

        if (!string.Equals(Input.NewPassword, Input.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "New password and confirmation do not match.";
            return;
        }

        var user = await UserManager.FindByIdAsync(userId);
        if (user is null || !user.IsActive)
        {
            await SignInManager.SignOutAsync();
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);
        await UserManager.UpdateSecurityStampAsync(user);
        await SignInManager.RefreshSignInAsync(user);

        var roles = await UserManager.GetRolesAsync(user);
        await Audit.AddAuditEntryAsync(
            "UserPasswordChanged",
            nameof(ApplicationUser),
            user.Id,
            $"User '{user.UserName}' updated their password.",
            explicitUserId: user.Id,
            explicitUserName: user.UserName ?? string.Empty,
            explicitUserRole: roles.FirstOrDefault() ?? "Staff");
        await Db.SaveChangesAsync();

        var safeTarget = SecurityUrlHelper.GetSafeLocalReturnUrl(ReturnUrl);
        Navigation.NavigateTo(safeTarget, forceLoad: true);
    }

    private sealed class ChangePasswordInputModel
    {
        [Required, MaxLength(128)]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required, MinLength(8), MaxLength(128)]
        public string NewPassword { get; set; } = string.Empty;

        [Required, MaxLength(128)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
