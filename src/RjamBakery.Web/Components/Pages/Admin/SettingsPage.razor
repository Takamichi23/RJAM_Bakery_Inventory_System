@page "/settings"
@attribute [Authorize(Roles = AppRoles.Owner)]
@using RjamBakery.Application.Contracts
@using RjamBakery.Application.Services
@inject ISystemSettingService SettingService
@inject ISnackbar Snackbar

<PageTitle>System Settings - RJAM Bakery</PageTitle>

<PageHeader Title="System Settings &amp; Schedules"
            Subtitle="Configure RJAM Bakery operating hours, closing schedule, currency symbol, and enforcement policies."
            Breadcrumbs="_breadcrumbs" />

@if (_initialLoading)
{
    <PageLoadingSkeleton Variant="Table" Rows="6" />
}
else
{
<MudPaper Elevation="0" Outlined="true" Style="border-radius:14px;">
    <MudTable Items="_rows" Dense="true" Elevation="0" Loading="_loading">
        <HeaderContent>
            <MudTh>Category</MudTh>
            <MudTh>Setting Key</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Style="min-width:190px;">Value</MudTh>
            <MudTh>Save</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Category">@context.Category</MudTd>
            <MudTd DataLabel="Key"><strong>@context.SettingKey</strong></MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Value">
                <MudTextField @bind-Value="context.EditableValue" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudTd>
            <MudTd DataLabel="Save">
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_savingKey == context.SettingKey)" OnClick="@(() => SaveAsync(context))">
                    <LoadingButtonContent Loading="@(_savingKey == context.SettingKey)" Text="Save" LoadingText="Saving..." />
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>
}

@code {
    private sealed class SettingRow
    {
        public string Category { get; init; } = string.Empty;
        public string SettingKey { get; init; } = string.Empty;
        public string Description { get; init; } = string.Empty;
        public string EditableValue { get; set; } = string.Empty;
    }

    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Dashboard", "/"), new("Settings", null, true)];
    private List<SettingRow> _rows = [];
    private bool _loading = true;
    private bool _initialLoading = true;
    private string? _savingKey;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await PageLoadingSkeleton.WaitVisualDelayAsync();
            await LoadAsync();
        }
        finally { _initialLoading = false; }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var items = await SettingService.GetAllAsync();
            _rows = items.Select(s => new SettingRow
            {
                Category = s.Category,
                SettingKey = s.SettingKey,
                Description = s.Description,
                EditableValue = s.SettingValue
            }).ToList();
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync(SettingRow row)
    {
        if (_savingKey is not null) return;
        _savingKey = row.SettingKey;
        try
        {
            await SettingService.UpdateAsync(new UpdateSystemSettingRequest(row.SettingKey, row.EditableValue));
            Snackbar.Add($"Saved setting '{row.SettingKey}'.", Severity.Success);
        }
        catch (DomainException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _savingKey = null; }
    }
}
