@page "/users"
@attribute [Authorize(Roles = AppRoles.Owner)]
@using RjamBakery.Application.Contracts
@using RjamBakery.Application.Services
@inject IUserManagementService UserService
@inject ISnackbar Snackbar

<PageTitle>User Management - RJAM Bakery</PageTitle>

<PageHeader Title="User Management"
            Subtitle="Manage employee accounts, role assignments, account status, and secure password resets."
            Breadcrumbs="_breadcrumbs">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="StartCreate">
            Create User
        </MudButton>
    </Actions>
</PageHeader>

<MudStack Spacing="4">
    <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="border-radius:14px;">
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_search" Placeholder="Search username, full name, or email..." Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" DebounceInterval="200" OnDebounceIntervalElapsed="LoadAsync" />
            <MudButton Variant="Variant.Outlined" Disabled="@(_loading && !_initialLoading)" OnClick="LoadAsync">
                <LoadingButtonContent Loading="@(_loading && !_initialLoading)" Text="Search" LoadingText="Searching..." />
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_creating)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="background:#FBF7F3; border-radius:14px;">
            <MudText Typo="Typo.h6" Class="mb-3">New Staff Account</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newUsername" Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newFullName" Label="Full Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newEmail" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect @bind-Value="_newRole" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var r in AppRoles.All) { <MudSelectItem Value="r">@r</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_newPassword"
                                  Label="Temporary Password"
                                  InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showNewPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                  AdornmentAriaLabel="Toggle password visibility"
                                  OnAdornmentClick="@(() => _showNewPassword = !_showNewPassword)" />
                </MudItem>
                <MudItem xs="12" sm="8" Class="d-flex align-center">
                    <MudCheckBox @bind-Value="_newMustChangePassword" Label="Require password change on first login" />
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="CreateUserAsync">
                    <LoadingButtonContent Loading="_saving" Text="Save User" LoadingText="Saving..." />
                </MudButton>
                <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="@(() => _creating = false)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_editTarget is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="background:#FBF7F3; border-radius:14px;">
            <MudText Typo="Typo.h6" Class="mb-3">Edit User — @_editTarget.UserName</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_editFullName" Label="Full Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_editEmail" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="_editRole" Label="Role" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var r in AppRoles.All) { <MudSelectItem Value="r">@r</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveUserEditAsync">
                    <LoadingButtonContent Loading="_saving" Text="Save Changes" LoadingText="Saving..." />
                </MudButton>
                <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="@(() => _editTarget = null)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_resetTarget is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="background:#FFF9EE; border-radius:14px;">
            <MudText Typo="Typo.h6" Class="mb-2">Reset Password — @_resetTarget.UserName</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_resetPassword"
                              Label="New Temporary Password"
                              InputType="@(_showResetPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showResetPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                              AdornmentAriaLabel="Toggle password visibility"
                              OnAdornmentClick="@(() => _showResetPassword = !_showResetPassword)" />
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="_saving" OnClick="ConfirmResetAsync">
                    <LoadingButtonContent Loading="_saving" Text="Reset Password" LoadingText="Resetting..." />
                </MudButton>
                <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="@(() => _resetTarget = null)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_initialLoading)
    {
        <PageLoadingSkeleton Variant="Table" Rows="5" />
    }
    else
    {
    <MudPaper Elevation="0" Outlined="true" Style="border-radius:14px;">
        <MudTable Items="_users" Dense="true" Hover="true" Elevation="0" Loading="_loading">
            <HeaderContent>
                <MudTh>Username</MudTh>
                <MudTh>Full Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Last Login</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Username">@context.UserName</MudTd>
                <MudTd DataLabel="Full Name">@context.FullName</MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Role"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Role</MudChip></MudTd>
                <MudTd DataLabel="Status">
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                        @if (context.MustChangePassword)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Temp Password</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Last Login">@(context.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never")</MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StartEdit(context))">Edit</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => { _creating = false; _editTarget = null; _resetTarget = context; _resetPassword = string.Empty; })">Reset Password</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="@(context.IsActive ? Color.Error : Color.Success)" Disabled="_saving" OnClick="@(() => ToggleActiveAsync(context))">
                            @(context.IsActive ? "Deactivate" : "Activate")
                        </MudButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
    }
</MudStack>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Dashboard", "/"), new("User Management", null, true)];
    private List<UserDto> _users = [];
    private string? _search;
    private bool _loading = true;
    private bool _initialLoading = true;
    private bool _saving;
    private bool _creating;
    private string _newUsername = string.Empty;
    private string _newFullName = string.Empty;
    private string _newEmail = string.Empty;
    private string _newRole = AppRoles.Cashier;
    private string _newPassword = string.Empty;
    private bool _newMustChangePassword = true;
    private bool _showNewPassword;
    private bool _showResetPassword;

    private UserDto? _editTarget;
    private string _editFullName = string.Empty;
    private string _editEmail = string.Empty;
    private string _editRole = AppRoles.Cashier;

    private UserDto? _resetTarget;
    private string _resetPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await PageLoadingSkeleton.WaitVisualDelayAsync();
            await LoadAsync();
        }
        finally { _initialLoading = false; }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _users = (await UserService.GetPagedAsync(_search, pageSize: 100)).Items.ToList(); }
        finally { _loading = false; }
    }

    private void StartCreate()
    {
        _editTarget = null;
        _resetTarget = null;
        _creating = true;
        _newUsername = _newFullName = _newEmail = _newPassword = string.Empty;
        _newRole = AppRoles.Cashier;
        _newMustChangePassword = true;
    }

    private void StartEdit(UserDto u)
    {
        _creating = false;
        _resetTarget = null;
        _editTarget = u;
        _editFullName = u.FullName;
        _editEmail = u.Email;
        _editRole = string.IsNullOrWhiteSpace(u.Role) ? AppRoles.Cashier : u.Role;
    }

    private async Task CreateUserAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            await UserService.CreateAsync(new CreateUserRequest(
                _newUsername, _newFullName, _newEmail, _newRole, _newPassword, _newMustChangePassword));
            Snackbar.Add("User account created.", Severity.Success);
            _creating = false;
            await LoadAsync();
        }
        catch (DomainException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task SaveUserEditAsync()
    {
        if (_editTarget is null || _saving) return;
        _saving = true;
        try
        {
            await UserService.UpdateAsync(new UpdateUserRequest(
                _editTarget.Id, _editFullName, _editEmail, _editRole, _editTarget.IsActive));
            Snackbar.Add($"Updated user '{_editTarget.UserName}'.", Severity.Success);
            _editTarget = null;
            await LoadAsync();
        }
        catch (DomainException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ConfirmResetAsync()
    {
        if (_resetTarget is null || _saving) return;
        _saving = true;
        try
        {
            await UserService.ResetPasswordAsync(new ResetPasswordRequest(_resetTarget.Id, _resetPassword, true));
            Snackbar.Add("Password reset. User will be prompted to set a new password at next sign-in.", Severity.Success);
            _resetTarget = null;
            await LoadAsync();
        }
        catch (DomainException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }

    private async Task ToggleActiveAsync(UserDto u)
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var next = !u.IsActive;
            await UserService.SetActiveStatusAsync(u.Id, next);
            Snackbar.Add(next ? $"Activated '{u.UserName}'." : $"Deactivated '{u.UserName}'.", Severity.Info);
            await LoadAsync();
        }
        catch (DomainException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }
}
