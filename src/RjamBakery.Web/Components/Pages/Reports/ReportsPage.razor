@page "/reports"
@attribute [Authorize(Roles = $"{AppRoles.Owner},{AppRoles.Manager}")]
@using RjamBakery.Application.Contracts
@using RjamBakery.Application.Services
@inject IReportingService ReportingService
@inject ISnackbar Snackbar

<PageTitle>Reports &amp; Analytics - RJAM Bakery</PageTitle>

<PageHeader Title="Operational Reports &amp; Exports"
            Subtitle="Review factory, store, production, sales revenue, delivery, and closing reports with PDF/Excel export."
            Breadcrumbs="_breadcrumbs" />

<MudStack Spacing="4">
    <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="border-radius:14px;">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudDatePicker @bind-Date="_fromDate" Label="From Date" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:190px;" />
            <MudDatePicker @bind-Date="_toDate" Label="To Date" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:190px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading" OnClick="LoadReportsAsync">
                <LoadingButtonContent Loading="_loading" Text="Refresh Reports" LoadingText="Refreshing..." />
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_loading)
    {
        <PageLoadingSkeleton Variant="Dashboard" />
    }
    else
    {
        <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-4" Style="background:#FFFFFF; border-radius:14px;">
            <MudTabPanel Text="Inventory">
                @if (_inv is not null)
                {
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Href="/api/reports/inventory/export?format=xlsx" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableView">Export Excel</MudButton>
                            <MudButton Href="/api/reports/inventory/export?format=pdf" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf">Export PDF</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.subtitle1">Low Stock &amp; Out of Stock Alerts (@_inv.LowAndOutOfStockItems.Count)</MudText>
                        <MudTable Items="_inv.LowAndOutOfStockItems" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Location</MudTh><MudTh>SKU</MudTh><MudTh>Item</MudTh><MudTh Style="text-align:right;">Available</MudTh><MudTh Style="text-align:right;">Min</MudTh><MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Location">@context.Bucket</MudTd>
                                <MudTd DataLabel="SKU">@context.Sku</MudTd>
                                <MudTd DataLabel="Item">@context.Name</MudTd>
                                <MudTd DataLabel="Available" Style="text-align:right;" Class="tabular-nums">@context.AvailableQuantity.ToString("0.##") @context.UnitCode</MudTd>
                                <MudTd DataLabel="Min" Style="text-align:right;" Class="tabular-nums">@context.MinStockLevel.ToString("0.##")</MudTd>
                                <MudTd DataLabel="Status"><StockStatusChip Status="@context.StockStatus" /></MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                }
            </MudTabPanel>

            <MudTabPanel Text="Production">
                @if (_prod is not null)
                {
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Href="@($"/api/reports/production/export?format=xlsx&fromDate={FromOnly:yyyy-MM-dd}&toDate={ToOnly:yyyy-MM-dd}")" Target="_blank" Variant="Variant.Outlined">Export Excel</MudButton>
                            <MudButton Href="@($"/api/reports/production/export?format=pdf&fromDate={FromOnly:yyyy-MM-dd}&toDate={ToOnly:yyyy-MM-dd}")" Target="_blank" Variant="Variant.Outlined">Export PDF</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.subtitle1">Completed Batches: @_prod.CompletedBatches | Total Output: @_prod.TotalUnitsProduced.ToString("0.##")</MudText>
                        <MudTable Items="_prod.ProductSummaries" Dense="true" Elevation="0">
                            <HeaderContent><MudTh>SKU</MudTh><MudTh>Product</MudTh><MudTh Style="text-align:right;">Batches</MudTh><MudTh Style="text-align:right;">Actual Output</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="SKU">@context.ProductSku</MudTd>
                                <MudTd DataLabel="Product">@context.ProductName</MudTd>
                                <MudTd DataLabel="Batches" Style="text-align:right;">@context.BatchCount</MudTd>
                                <MudTd DataLabel="Output" Style="text-align:right;" Class="tabular-nums">@context.TotalActualQuantity.ToString("0.##") @context.UnitCode</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                }
            </MudTabPanel>

            <MudTabPanel Text="Sales Revenue">
                @if (_sales is not null)
                {
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Href="@($"/api/reports/sales/export?format=xlsx&fromUtc={Uri.EscapeDataString(FromUtc.ToString("O"))}&toUtc={Uri.EscapeDataString(ToUtc.ToString("O"))}")" Target="_blank" Variant="Variant.Outlined">Export Excel</MudButton>
                            <MudButton Href="@($"/api/reports/sales/export?format=pdf&fromUtc={Uri.EscapeDataString(FromUtc.ToString("O"))}&toUtc={Uri.EscapeDataString(ToUtc.ToString("O"))}")" Target="_blank" Variant="Variant.Outlined">Export PDF</MudButton>
                        </MudStack>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            Net Sales Revenue: @_sales.CurrencySymbol@_sales.NetSalesRevenue.ToString("N2") (@_sales.CompletedCount completed, @_sales.VoidedCount voided, @_sales.RefundedCount refunded). Revenue excludes COGS and operating expenses.
                        </MudAlert>
                        <MudTable Items="_sales.BestSellingProducts" Dense="true" Elevation="0">
                            <HeaderContent><MudTh>SKU</MudTh><MudTh>Product</MudTh><MudTh Style="text-align:right;">Qty Sold</MudTh><MudTh Style="text-align:right;">Gross Sales Revenue</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="SKU">@context.Sku</MudTd>
                                <MudTd DataLabel="Product">@context.ProductName</MudTd>
                                <MudTd DataLabel="Qty Sold" Style="text-align:right;" Class="tabular-nums">@context.TotalQuantitySold.ToString("0.##")</MudTd>
                                <MudTd DataLabel="Revenue" Style="text-align:right;" Class="tabular-nums">@_sales.CurrencySymbol@context.GrossSalesRevenue.ToString("N2")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                }
            </MudTabPanel>

            <MudTabPanel Text="Deliveries">
                @if (_del is not null)
                {
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Href="@($"/api/reports/deliveries/export?format=xlsx&fromUtc={Uri.EscapeDataString(FromUtc.ToString("O"))}&toUtc={Uri.EscapeDataString(ToUtc.ToString("O"))}")" Target="_blank" Variant="Variant.Outlined">Export Excel</MudButton>
                            <MudButton Href="@($"/api/reports/deliveries/export?format=pdf&fromUtc={Uri.EscapeDataString(FromUtc.ToString("O"))}&toUtc={Uri.EscapeDataString(ToUtc.ToString("O"))}")" Target="_blank" Variant="Variant.Outlined">Export PDF</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.subtitle1">Pending: @_del.PendingCount | Dispatched: @_del.DispatchedCount | Discrepancy Review: @_del.PartiallyReceivedCount | Received: @_del.ReceivedCount</MudText>
                        <MudTable Items="_del.Deliveries" Dense="true" Elevation="0">
                            <HeaderContent><MudTh>Delivery #</MudTh><MudTh>Status</MudTh><MudTh>Driver</MudTh><MudTh>Dispatched</MudTh><MudTh>Received</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Delivery #">@context.DeliveryNumber</MudTd>
                                <MudTd DataLabel="Status"><StockStatusChip Status="@context.Status.ToString()" /></MudTd>
                                <MudTd DataLabel="Driver">@context.DriverOrCourierName</MudTd>
                                <MudTd DataLabel="Dispatched">@(context.DispatchedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</MudTd>
                                <MudTd DataLabel="Received">@(context.ReceivedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                }
            </MudTabPanel>

            <MudTabPanel Text="Closing &amp; Waste">
                @if (_closing is not null)
                {
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Href="@($"/api/reports/closing/export?format=xlsx&fromDate={FromOnly:yyyy-MM-dd}&toDate={ToOnly:yyyy-MM-dd}")" Target="_blank" Variant="Variant.Outlined">Export Excel</MudButton>
                            <MudButton Href="@($"/api/reports/closing/export?format=pdf&fromDate={FromOnly:yyyy-MM-dd}&toDate={ToOnly:yyyy-MM-dd}")" Target="_blank" Variant="Variant.Outlined">Export PDF</MudButton>
                        </MudStack>
                        <MudTable Items="_closing.Closings" Dense="true" Elevation="0">
                            <HeaderContent><MudTh>Date</MudTh><MudTh>Closing #</MudTh><MudTh>Status</MudTh><MudTh Style="text-align:right;">Total Carryover</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Date">@context.OperatingDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="Closing #">@context.ClosingNumber</MudTd>
                                <MudTd DataLabel="Status"><StockStatusChip Status="@context.Status.ToString()" /></MudTd>
                                <MudTd DataLabel="Carryover" Style="text-align:right;" Class="tabular-nums">@context.Items.Sum(i => i.CarryoverToNextDay).ToString("0.##")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Dashboard", "/"), new("Reports", null, true)];
    private DateTime? _fromDate = DateTime.Today.AddDays(-7);
    private DateTime? _toDate = DateTime.Today;
    private bool _loading;

    private InventoryReportDto? _inv;
    private ProductionReportDto? _prod;
    private SalesReportDto? _sales;
    private DeliveryReportDto? _del;
    private ClosingReportDto? _closing;

    private DateOnly FromOnly => DateOnly.FromDateTime(_fromDate ?? DateTime.Today.AddDays(-7));
    private DateOnly ToOnly => DateOnly.FromDateTime(_toDate ?? DateTime.Today);
    private DateTime FromUtc => DateTime.SpecifyKind(FromOnly.ToDateTime(TimeOnly.MinValue), DateTimeKind.Local).ToUniversalTime();
    private DateTime ToUtc => DateTime.SpecifyKind(ToOnly.ToDateTime(TimeOnly.MaxValue), DateTimeKind.Local).ToUniversalTime();

    protected override async Task OnInitializedAsync() => await LoadReportsAsync();

    private async Task LoadReportsAsync()
    {
        if (FromOnly > ToOnly)
        {
            Snackbar.Add("From Date cannot be later than To Date.", Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            await PageLoadingSkeleton.WaitVisualDelayAsync(550);
            _inv = await ReportingService.GetInventoryReportAsync();
            _prod = await ReportingService.GetProductionReportAsync(FromOnly, ToOnly);
            _sales = await ReportingService.GetSalesReportAsync(FromUtc, ToUtc);
            _del = await ReportingService.GetDeliveryReportAsync(FromUtc, ToUtc);
            _closing = await ReportingService.GetClosingReportAsync(FromOnly, ToOnly);
        }
        catch (DomainException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _loading = false; }
    }
}
