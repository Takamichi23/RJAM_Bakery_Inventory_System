@if (string.Equals(Variant, "Dashboard", StringComparison.OrdinalIgnoreCase))
{
    <MudStack Spacing="4" Class="rjam-skeleton-group">
        <MudGrid Spacing="3">
            @for (var i = 0; i < 8; i++)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="border-radius:12px;">
                        <MudSkeleton Width="58%" Height="14px" />
                        <MudSkeleton Width="42%" Height="32px" Class="mt-2" />
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="5">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="border-radius:14px;">
                    <MudSkeleton Width="45%" Height="24px" Class="mb-3" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" Class="mb-2" Style="border-radius:8px;" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" Style="border-radius:8px;" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="border-radius:14px;">
                    <MudSkeleton Width="52%" Height="24px" Class="mb-3" />
                    @for (var r = 0; r < 5; r++)
                    {
                        <MudSkeleton Width="100%" Height="36px" Class="mb-2" />
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
}
else if (string.Equals(Variant, "Pos", StringComparison.OrdinalIgnoreCase))
{
    <MudGrid Spacing="3" Class="rjam-skeleton-group">
        @for (var i = 0; i < 6; i++)
        {
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-3" Style="border-radius:14px;">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-3" Style="border-radius:10px;" />
                    <MudSkeleton Width="70%" Height="20px" />
                    <MudSkeleton Width="45%" Height="14px" Class="mt-1 mb-3" />
                    <div class="d-flex justify-space-between align-center pt-2">
                        <MudSkeleton Width="30%" Height="22px" />
                        <MudSkeleton Width="35%" Height="32px" />
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 rjam-skeleton-group" Style="border-radius:14px;">
        <MudStack Spacing="2">
            <MudSkeleton Width="32%" Height="22px" Class="mb-1" />
            @for (var i = 0; i < Rows; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="38px" Style="border-radius:8px;" />
            }
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public string Variant { get; set; } = "Table";
    [Parameter] public int Rows { get; set; } = 6;

    private static readonly bool IsAutomatedTestRunner =
        string.Equals(Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT"), "Testing", StringComparison.OrdinalIgnoreCase)
        || AppDomain.CurrentDomain.GetAssemblies().Any(a =>
        {
            var name = a.GetName().Name;
            return name is not null
                && (name.StartsWith("xunit", StringComparison.OrdinalIgnoreCase)
                    || name.StartsWith("bunit", StringComparison.OrdinalIgnoreCase));
        });

    /// <summary>
    /// Ensures the skeleton loading state remains visible long enough (~650ms) for a smooth visual transition
    /// in live browser sessions while staying 0ms inside automated xUnit/bUnit test runs.
    /// </summary>
    public static async Task WaitVisualDelayAsync(int milliseconds = 650)
    {
        if (IsAutomatedTestRunner || milliseconds <= 0)
        {
            return;
        }

        await Task.Yield();
        await Task.Delay(milliseconds);
    }
}
