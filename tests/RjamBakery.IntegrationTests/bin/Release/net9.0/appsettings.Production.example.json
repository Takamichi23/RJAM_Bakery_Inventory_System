{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_HOST;Port=3306;Database=rjam_bakery_ms_db;User=rjam_app_user;Password=REPLACE_WITH_STRONG_PASSWORD;SslMode=Required;"
  },
  "Security": {
    "EnableHttpsRedirection": true,
    "RequireHttpsCookies": true,
    "TrustForwardedHeaders": true,
    "AllowedOrigins": [],
    "EnableRateLimiting": true,
    "AuthPermitLimitPerMinute": 10,
    "ApiPermitLimitPerMinute": 120,
    "ExportPermitLimitPerMinute": 20,
    "MaxRequestBodySizeBytes": 5242880,
    "DataProtectionKeysPath": "./keys"
  },
  "AllowedHosts": "your-bakery-domain.com;www.your-bakery-domain.com"
}
